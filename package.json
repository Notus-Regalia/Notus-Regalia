{
  "name": "the-fool",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --pretty false",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:outdated": "npm outdated",
    "security:ci": "npm run typecheck && npm run security:audit:prod"
  },
  "dependencies": {
