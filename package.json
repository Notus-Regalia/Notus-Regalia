    "gsap": "^3.14.2",
    "motion": "^12.41.0",
    "next": "^15.5.19",
    "ogl": "^1.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.10.1",
