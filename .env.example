# Copy to .env.local and fill in. Never commit real secrets.

# Set to 'true' to show executive cards on Teams page, 'false' to hide them.
NEXT_PUBLIC_SHOW_EXECUTIVES=

# Canonical site origin. Drives sitemap.xml <loc> URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# --- Mux (signed playback) ---
NEXT_PUBLIC_MUX_PLAYBACK_ID=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# --- Embedding (iframe) allowlist ---
# Origins allowed to show this site inside an <iframe> (e.g. a portfolio).
# Space- or comma-separated full origins: scheme://host[:port], no paths.
#   PORTFOLIO_ORIGINS="https://portfolio.example.com http://localhost:3000"
# Sets CSP `frame-ancestors 'self' <origins>` and drops X-Frame-Options.
# Leave empty to block all framing (frame-ancestors 'none' + X-Frame-Options: DENY).
# Invalid entries are ignored. Read at build time too, so redeploy after changing.
PORTFOLIO_ORIGINS=
